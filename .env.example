TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id

# Local status API for dashboard/live checks.
STATUS_API_ENABLED=true
STATUS_HOST=0.0.0.0
STATUS_PORT=3001

# Writes docs/status.json from the running bot.
STATUS_FILE_ENABLED=true
STATUS_FILE_INTERVAL_MS=60000

# Optional: auto-commit and push docs/status.json for GitHub Pages.
# Enable only after your local git auth is ready.
STATUS_GIT_PUSH_ENABLED=false
STATUS_GIT_PUSH_INTERVAL_MS=300000
STATUS_GIT_COMMIT_MESSAGE=Update Moonlight status
